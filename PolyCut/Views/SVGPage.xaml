<Page x:Class="SVGPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:beh="clr-namespace:PolyCut"
      xmlns:c="clr-namespace:ValueConverters;assembly=ValueConverters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:local="clr-namespace:PolyCut"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pc="clr-namespace:PolyCut.Core;assembly=PolyCut.Core"
      xmlns:polycutShared="clr-namespace:PolyCut.Shared;assembly=PolyCut.Shared"
      xmlns:rc="clr-namespace:PolyCut.RichCanvas;assembly=PolyCut.RichCanvas"
      xmlns:svg="http://sharpvectors.codeplex.com/runtime/"
      xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
      xmlns:system="clr-namespace:System;assembly=mscorlib"
      xmlns:theme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      x:Name="SVGPageView"
      Title="SVGPage"
      Margin="0 5 0 0"
      d:DataContext="{d:DesignInstance Type=local:SVGPageViewModel}"
      d:DesignHeight="1000"
      d:DesignWidth="1000"
      AllowDrop="True"
      Background="{DynamicResource ControlFillColorTertiaryBrush}"
      Drop="Page_Drop"
      ScrollViewer.CanContentScroll="False"
      Unloaded="SVGPageView_Unloaded"
      mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded" SourceObject="{Binding ElementName=SVGPageView}">
            <i:InvokeCommandAction Command="{Binding MainVM.MainViewLoadedCommand}" />
        </i:EventTrigger>
        <i:KeyTrigger Key="Delete" SourceObject="{Binding ElementName=zoomPanControl}">
            <i:InvokeCommandAction Command="{Binding DeleteDrawableElementCommand}" />
        </i:KeyTrigger>
        <i:KeyTrigger Key="OemCloseBrackets" SourceObject="{Binding ElementName=zoomPanControl}">
            <i:InvokeCommandAction Command="{Binding PreviewKeyDownCommand}" CommandParameter="]" />
        </i:KeyTrigger>
        <i:KeyTrigger Key="OemOpenBrackets" SourceObject="{Binding ElementName=zoomPanControl}">
            <i:InvokeCommandAction Command="{Binding PreviewKeyDownCommand}" CommandParameter="[" />
        </i:KeyTrigger>
    </i:Interaction.Triggers>


    <Grid Margin="5 5 10 5">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="55" MinWidth="55" MaxWidth="55" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" MinWidth="380" MaxWidth="800" />
        </Grid.ColumnDefinitions>
        <GridSplitter Width="10"
                      Margin="0 0 -10 0" Panel.ZIndex="1"
                      Background="Transparent" IsTabStop="False" ResizeDirection="Columns" />


        <ui:Card Grid.Column="0"
                 Margin="5 5 0 5" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center"
                 VerticalContentAlignment="Stretch" Panel.ZIndex="1"
                 beh:BackdropSampler.Corner="Left"
                 beh:BackdropSampler.IsEnabled="{Binding MainVM.IsWindows}"
                 beh:BackdropSampler.SampleX="2" beh:BackdropSampler.TintColor="#0AFFFFFF" Background="#323232" BorderThickness="0">
            <ui:Card.Effect>
                <DropShadowEffect BlurRadius="10" Direction="0" Opacity="0.4" ShadowDepth="0" />
            </ui:Card.Effect>

            <local:ToolSelectorPane x:Name="ToolSelectorPanel" Background="Transparent" />

        </ui:Card>








        <ui:Card Grid.Column="1"
                 Height="50"
                 Margin="5" Padding="8" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="20"
                 beh:BackdropSampler.Corner="Left"
                 beh:BackdropSampler.IsEnabled="{Binding MainVM.IsWindows}"
                 beh:BackdropSampler.SampleX="2" beh:BackdropSampler.TintColor="#0AFFFFFF" polycutShared:TextEditHelper.IsTextStyleHost="True" Background="#323232" BorderThickness="0"
                 IsKeyboardFocusWithinChanged="TextStyleCard_IsKeyboardFocusWithinChanged"
                 Visibility="{Binding CanvasToolModeIsText, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:Card.Effect>
                <DropShadowEffect BlurRadius="10" Direction="0" Opacity="0.4" ShadowDepth="0" />
            </ui:Card.Effect>
            <Grid>

                <StackPanel Orientation="Horizontal">
                    <Label Margin="0 2 10 0" VerticalAlignment="Center" Content="Font" />
                    <local:FontPickerComboBox x:Name="OverlayFontPicker"
                                              Width="200"
                                              DropDownClosed="TextStyleControl_DropDownClosed"
                                              SelectedFont="{Binding CanvasFontFamily, Mode=TwoWay}" />
                    <Separator Margin="5 0" />
                    <Label Margin="0 2 10 0" VerticalAlignment="Center" Content="Size (pt)" />
                    <ComboBox x:Name="OverlayFontSizeComboBox"
                              Width="80"
                              Padding="7"
                              Background="Transparent" DropDownClosed="TextStyleControl_DropDownClosed" IsEditable="True" SelectedIndex="6"
                              Text="{Binding CanvasFontSize, Mode=TwoWay}">
                        <ComboBoxItem Content="3" />
                        <ComboBoxItem Content="4" />
                        <ComboBoxItem Content="6" />
                        <ComboBoxItem Content="8" />
                        <ComboBoxItem Content="10" />
                        <ComboBoxItem Content="12" />
                        <ComboBoxItem Content="14" />
                        <ComboBoxItem Content="16" />
                        <ComboBoxItem Content="18" />
                        <ComboBoxItem Content="20" />
                        <ComboBoxItem Content="24" />
                        <ComboBoxItem Content="28" />
                        <ComboBoxItem Content="32" />
                        <ComboBoxItem Content="36" />
                        <ComboBoxItem Content="48" />
                        <ComboBoxItem Content="72" />
                    </ComboBox>
                    <Separator Margin="5 0" />
                    <ToggleButton x:Name="OverlayBoldToggleButton"
                                  Width="30" Height="30"
                                  Margin="0 0 5 0" Padding="2"
                                  BorderBrush="Transparent"
                                  IsChecked="{Binding CanvasFontWeightIsBold, Mode=TwoWay}">
                        <ui:SymbolIcon Symbol="TextBold16" />
                    </ToggleButton>
                    <ToggleButton x:Name="OverlayItalicToggleButton"
                                  Width="30" Height="30"
                                  Margin="0 0 5 0" Padding="2"
                                  BorderBrush="Transparent"
                                  IsChecked="{Binding CanvasFontStyleIsItalic, Mode=TwoWay}">
                        <ui:SymbolIcon Symbol="TextItalic16" />
                    </ToggleButton>
                </StackPanel>
            </Grid>

        </ui:Card>

        <rc:ZoomBorder x:Name="zoomPanControl"
                       Grid.Column="0" Grid.ColumnSpan="2"
                       Background="Transparent"
                       CanvasMode="{Binding CanvasToolMode, Mode=OneWay}"
                       CanvasTextBox="{Binding CanvasTextBox}"
                       ClipToBounds="True"
                       Cursor="{Binding CanvasToolMode, Converter={StaticResource CanvasToolModeCursorConverter}, Mode=OneWay}"
                       LeftButtonAction="None" MiddleButtonAction="Move" RightButtonAction="None" ScaleAmount="0.002" ScaleMax="150"
                       ScaleMin="0.01">
            <rc:ZoomBorder.ContextMenu>
                <ContextMenu>

                    <MenuItem IsTabStop="False">
                        <MenuItem.Template>
                            <ControlTemplate TargetType="MenuItem">
                                <ContentPresenter Content="{TemplateBinding Header}" />
                            </ControlTemplate>
                        </MenuItem.Template>

                        <MenuItem.Header>
                            <StackPanel Margin="10 5" HorizontalAlignment="Center" Orientation="Horizontal">
                                <StackPanel.Resources>
                                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                                </StackPanel.Resources>

                                <ui:Button x:Name="ContextCutButton"
                                           Width="50"
                                           Appearance="Transparent" BorderThickness="0" Click="ContextCutButton_Click"
                                           Command="{Binding MainVM.CutSelectionCommand}">
                                    <StackPanel>
                                        <ui:SymbolIcon Symbol="Cut20" />
                                        <TextBlock Margin="0 5 0 0" FontSize="12" Text="Cut" />
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button x:Name="ContextCopyButton"
                                           Width="50"
                                           Appearance="Transparent" BorderThickness="0"
                                           Command="{Binding MainVM.CopySelectionCommand}">
                                    <StackPanel>
                                        <ui:SymbolIcon Symbol="Copy20" />
                                        <TextBlock Margin="0 5 0 0" FontSize="12" Text="Copy" />
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button x:Name="ContextPasteButton"
                                           Width="50"
                                           Appearance="Transparent" BorderThickness="0"
                                           Command="{Binding MainVM.PasteClipboardCommand}">
                                    <StackPanel>
                                        <ui:SymbolIcon Symbol="ClipboardPaste20" />
                                        <TextBlock Margin="0 5 0 0" FontSize="12" Text="Paste" />
                                    </StackPanel>
                                </ui:Button>

                                <Separator Margin="0 0 5 0" />

                                <ui:Button x:Name="ContextSelectAllButton"
                                           Width="50"
                                           Padding="0 5"
                                           Appearance="Transparent" BorderThickness="0" Click="ContextSelectAllButton_Click"
                                           IsEnabled="{Binding MainVM.HasDrawables}">
                                    <StackPanel>
                                        <ui:SymbolIcon Symbol="CopySelect20" />
                                        <TextBlock Margin="0 5 0 0" FontSize="11" Text="Select All" />
                                    </StackPanel>
                                </ui:Button>

                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>

                    <Separator x:Name="CanvasContextMenuSeparator" />

                    <!--  selection-dependent entries (hidden when nothing is selected)  -->

                    <MenuItem x:Name="StyleMenuItem" IsTabStop="False">
                        <MenuItem.Template>
                            <ControlTemplate TargetType="MenuItem">
                                <ContentPresenter Content="{TemplateBinding Header}" />
                            </ControlTemplate>
                        </MenuItem.Template>

                        <MenuItem.Header>

                            <Grid Margin="10 10 10 0">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <local:ColorPickerControl x:Name="ContextStrokePicker"
                                                          Grid.Row="0"
                                                          ColorSelected="ContextStrokePicker_ColorSelected"
                                                          CurrentColor="{Binding MainVM.SelectedDrawable.Stroke, Mode=OneWay}"
                                                          LabelText="Stroke" PopupOpening="ContextStrokePicker_PopupOpening" />

                                <local:ColorPickerControl x:Name="ContextFillPicker"
                                                          Grid.Row="1"
                                                          Margin="0 10"
                                                          ColorSelected="ContextFillPicker_ColorSelected"
                                                          CurrentColor="{Binding MainVM.SelectedDrawable.Fill, Mode=OneWay}"
                                                          LabelText="Fill" PopupOpening="ContextFillPicker_PopupOpening" />

                            </Grid>

                        </MenuItem.Header>
                    </MenuItem>

                    <Separator />

                    <MenuItem x:Name="ZoomMenuItem">
                        <MenuItem.Template>
                            <ControlTemplate TargetType="MenuItem">
                                <ContentPresenter Content="{TemplateBinding Header}" />
                            </ControlTemplate>
                        </MenuItem.Template>
                        <MenuItem.Header>

                            <Border Grid.ColumnSpan="2"
                                    Margin="5"
                                    Background="{StaticResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="4">
                                <StackPanel Margin="5" HorizontalAlignment="Center" Orientation="Horizontal">
                                    <Button x:Name="MenuReduceZoomButton"
                                            Height="40"
                                            Background="Transparent" BorderThickness="0" Click="MenuReduceZoomButton_Click">
                                        <ui:SymbolIcon Symbol="ZoomOut20" />
                                    </Button>
                                    <Button x:Name="MenuZoomTo100Percent"
                                            Width="80" Height="40"
                                            VerticalAlignment="Center"
                                            Background="Transparent" BorderThickness="0" Click="MenuZoomTo100Percent_Click">
                                        <TextBlock Margin="0 -2 0 0" Text="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.Scale, Converter={local:ZoomBorderScaleToPercentConverter}}" />
                                    </Button>
                                    <Button x:Name="MenuIncreaseZoomButton"
                                            Height="40"
                                            Background="Transparent" BorderThickness="0" Click="MenuIncreaseZoomButton_Click">
                                        <ui:SymbolIcon Symbol="ZoomIn20" />
                                    </Button>

                                    <Separator Margin="5 2" />

                                    <Button x:Name="MenuResetZoomButton"
                                            Height="40"
                                            Background="Transparent" BorderThickness="0" Click="MenuResetZoomButton_Click">
                                        <ui:SymbolIcon Symbol="ZoomFit20" />
                                    </Button>
                                </StackPanel>


                            </Border>





                        </MenuItem.Header>
                    </MenuItem>

                    <ui:MenuItem x:Name="ArrangeMenuItem" Header=" Arrange" Icon="{ui:SymbolIcon Symbol=Archive16}">

                        <MenuItem Focusable="False" IsTabStop="False">

                            <MenuItem.Template>
                                <ControlTemplate TargetType="{x:Type MenuItem}">
                                    <ContentPresenter Content="{TemplateBinding Header}" />
                                </ControlTemplate>
                            </MenuItem.Template>

                            <MenuItem.Header>

                                <StackPanel Margin="5 2" Orientation="Horizontal">

                                    <ui:Button Width="70"
                                               Appearance="Transparent" BorderThickness="0"
                                               Command="{Binding MainVM.MoveSelectedItemsCanvasUpCommand}">
                                        <StackPanel>

                                            <Grid Width="25" Height="25">


                                                <Border Width="11" Height="11"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Background="{DynamicResource ContextMenuBackground}"
                                                        BorderBrush="White" BorderThickness="1" CornerRadius="2">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform X="-2" Y="-2" />
                                                    </Border.RenderTransform>
                                                </Border>

                                                <Border Width="11" Height="11"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Background="White" BorderBrush="White" BorderThickness="1" CornerRadius="2">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform X="2" Y="2" />
                                                    </Border.RenderTransform>
                                                </Border>

                                            </Grid>
                                            <TextBlock Margin="0 5 0 0" HorizontalAlignment="Center"
                                                       FontSize="10" Text="Bring Forward" TextAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ui:Button>

                                    <ui:Button Width="70"
                                               Appearance="Transparent" BorderThickness="0"
                                               Command="{Binding MainVM.MoveSelectedItemsCanvasToTopCommand}">
                                        <StackPanel>

                                            <Grid Width="25" Height="25">
                                                <Border Width="11" Height="11"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Background="{DynamicResource ContextMenuBackground}"
                                                        BorderBrush="White" BorderThickness="1" CornerRadius="2">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform X="-3" Y="-3" />
                                                    </Border.RenderTransform>
                                                </Border>

                                                <Border Width="11" Height="11"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Background="{DynamicResource ContextMenuBackground}"
                                                        BorderBrush="White" BorderThickness="1" CornerRadius="2">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform X="0" Y="0" />
                                                    </Border.RenderTransform>
                                                </Border>


                                                <Border Width="11" Height="11"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Background="White" BorderBrush="White" BorderThickness="1" CornerRadius="2">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform X="3" Y="3" />
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Grid>
                                            <TextBlock Margin="0 5 0 0" HorizontalAlignment="Center"
                                                       FontSize="10" Text="Bring To Front" TextAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ui:Button>

                                    <ui:Button Width="70"
                                               Appearance="Transparent" BorderThickness="0"
                                               Command="{Binding MainVM.MoveSelectedItemsCanvasDownCommand}">
                                        <StackPanel>

                                            <Grid Width="25" Height="25">
                                                <Border Width="11" Height="11"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Background="White" BorderBrush="White" BorderThickness="1" CornerRadius="2">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform X="-2" Y="-2" />
                                                    </Border.RenderTransform>
                                                </Border>


                                                <Border Width="11" Height="11"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Background="{DynamicResource ContextMenuBackground}"
                                                        BorderBrush="White" BorderThickness="1" CornerRadius="2">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform X="2" Y="2" />
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Grid>
                                            <TextBlock Margin="0 5 0 0" HorizontalAlignment="Center"
                                                       FontSize="10" Text="Send Backwards" TextAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ui:Button>

                                    <ui:Button Width="70"
                                               Appearance="Transparent" BorderThickness="0"
                                               Command="{Binding MainVM.MoveSelectedItemsCanvasToBottomCommand}">
                                        <StackPanel>

                                            <Grid Width="25" Height="25">
                                                <Border Width="11" Height="11"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Background="White" BorderBrush="White" BorderThickness="1" CornerRadius="2">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform X="-3" Y="-3" />
                                                    </Border.RenderTransform>
                                                </Border>

                                                <Border Width="11" Height="11"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Background="{DynamicResource ContextMenuBackground}"
                                                        BorderBrush="White" BorderThickness="1" CornerRadius="2">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform X="0" Y="0" />
                                                    </Border.RenderTransform>
                                                </Border>

                                                <Border Width="11" Height="11"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Background="{DynamicResource ContextMenuBackground}"
                                                        BorderBrush="White" BorderThickness="1" CornerRadius="2">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform X="3" Y="3" />
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Grid>
                                            <TextBlock Margin="0 5 0 0" HorizontalAlignment="Center"
                                                       FontSize="10" Text="Send To Back" TextAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ui:Button>


                                </StackPanel>

                            </MenuItem.Header>

                        </MenuItem>



                    </ui:MenuItem>

                    <ui:MenuItem x:Name="CombineMenuItem" Header="Combine">

                        <MenuItem Focusable="False" IsTabStop="False">

                            <MenuItem.Template>
                                <ControlTemplate TargetType="{x:Type MenuItem}">
                                    <ContentPresenter Content="{TemplateBinding Header}" />
                                </ControlTemplate>
                            </MenuItem.Template>

                            <MenuItem.Header>

                                <StackPanel Margin="5 2" Orientation="Horizontal">

                                    <ui:Button Width="70"
                                               Appearance="Transparent" BorderThickness="0"
                                               Command="{Binding MainVM.UnionShapesCommand}">
                                        <StackPanel>

                                            <ui:SymbolIcon Filled="True" FontSize="18" Symbol="ShapeUnion20" />
                                            <TextBlock Margin="0 5 0 0" HorizontalAlignment="Center"
                                                       FontSize="12" Text="Union" TextAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ui:Button>

                                    <ui:Button Width="70"
                                               Appearance="Transparent" BorderThickness="0"
                                               Command="{Binding MainVM.IntersectShapesCommand}">
                                        <StackPanel>

                                            <ui:SymbolIcon Filled="True" FontSize="18" Symbol="ShapeIntersect20" />

                                            <TextBlock Margin="0 5 0 0" HorizontalAlignment="Center"
                                                       FontSize="12" Text="Intersect" TextAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ui:Button>

                                    <ui:Button Width="70"
                                               Appearance="Transparent" BorderThickness="0"
                                               Command="{Binding MainVM.SubtractShapesCommand}">
                                        <StackPanel>

                                            <ui:SymbolIcon Filled="True" FontSize="18" Symbol="ShapeSubtract20" />

                                            <TextBlock Margin="0 5 0 0" HorizontalAlignment="Center"
                                                       FontSize="12" Text="Subtract" TextAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ui:Button>

                                    <ui:Button Width="70"
                                               Appearance="Transparent" BorderThickness="0"
                                               Command="{Binding MainVM.XorShapesCommand}">
                                        <StackPanel>

                                            <ui:SymbolIcon Filled="True" FontSize="18" Symbol="ShapeExclude20" />

                                            <TextBlock Margin="0 5 0 0" HorizontalAlignment="Center"
                                                       FontSize="12" Text="Exclude" TextAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ui:Button>


                                </StackPanel>

                            </MenuItem.Header>

                        </MenuItem>



                    </ui:MenuItem>

                </ContextMenu>
            </rc:ZoomBorder.ContextMenu>

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">

                <Canvas x:Name="ReferenceCanvas"
                        Width="{Binding MainVM.Printer.BedWidth, Mode=TwoWay}"
                        Height="{Binding MainVM.Printer.BedHeight, Mode=TwoWay}"
                        Margin="0 0 0 0">

                    <rc:PolyCanvas x:Name="mainCanvas"
                                   Width="{Binding MainVM.Printer.BedWidth, Mode=TwoWay}"
                                   Height="{Binding MainVM.Printer.BedHeight, Mode=TwoWay}"
                                   Margin="0 0 0 0" Panel.ZIndex="1"
                                   Background="Transparent"
                                   ChildrenCollection="{Binding MainVM.DrawableCollection}"
                                   ClipToBounds="False" />


                    <Border x:Name="CuttingMatBounds"
                            Width="{Binding MainVM.Printer.BedWidth, Mode=TwoWay}"
                            Height="{Binding MainVM.Printer.BedHeight, Mode=TwoWay}"
                            Panel.ZIndex="-3"
                            Background="{Binding MainVM.UIConfiguration.CanvasThemeColour}"
                            BorderBrush="White" BorderThickness="0.4" CornerRadius="5">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Direction="0" Opacity="0.78" ShadowDepth="0"
                                              Color="Black" />
                        </Border.Effect>
                    </Border>

                    <Border x:Name="GridClipBorder"
                            Width="{Binding MainVM.Printer.BedWidth, Mode=TwoWay}"
                            Height="{Binding MainVM.Printer.BedHeight, Mode=TwoWay}"
                            Panel.ZIndex="0"
                            ClipToBounds="True" CornerRadius="0">


                        <Border.Clip>
                            <RectangleGeometry RadiusX="{Binding CornerRadius.TopLeft, ElementName=GridClipBorder}" RadiusY="{Binding CornerRadius.TopLeft, ElementName=GridClipBorder}">
                                <RectangleGeometry.Rect>
                                    <MultiBinding Converter="{local:RectFromSizeConverter}">
                                        <Binding ElementName="GridClipBorder" Path="ActualWidth" />
                                        <Binding ElementName="GridClipBorder" Path="ActualHeight" />
                                    </MultiBinding>
                                </RectangleGeometry.Rect>
                            </RectangleGeometry>
                        </Border.Clip>

                        <local:GridPreviewControl Width="{Binding MainVM.Printer.BedWidth, Mode=OneWay}"
                                                  Height="{Binding MainVM.Printer.BedHeight, Mode=OneWay}"
                                                  Panel.ZIndex="-1"
                                                  GridConfig="{Binding MainVM.UIConfiguration.GridConfig}"
                                                  IsHitTestVisible="False"
                                                  Visibility="{Binding MainVM.UIConfiguration.ShowGrid, Converter={StaticResource BooleanToVisibilityConverter}}" />




                    </Border>


                    <!--  Fill the offset outside space  -->
                    <Path Canvas.Left="0" Canvas.Bottom="0"
                          ClipToBounds="True" IsHitTestVisible="False" StrokeThickness="0.5"
                          Visibility="{Binding MainVM.WorkingAreaVisibility, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Path.Data>
                            <CombinedGeometry GeometryCombineMode="Xor">
                                <CombinedGeometry.Geometry1>
                                    <RectangleGeometry Rect="{Binding MainVM.Printer.BedRect}" />
                                </CombinedGeometry.Geometry1>
                                <CombinedGeometry.Geometry2>
                                    <RectangleGeometry Rect="{Binding MainVM.Printer.WorkingRect}" />
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </Path.Data>
                        <Path.Fill>
                            <LinearGradientBrush SpreadMethod="Reflect" StartPoint="0 0" EndPoint="0.01 0.01">
                                <GradientStop Offset="0.5" Color="#30FFFFFF" />
                                <GradientStop Offset="0.5" Color="#40FFFFFF" />
                            </LinearGradientBrush>
                            <!--<SolidColorBrush Color="#40000000"/>-->
                        </Path.Fill>
                        <Path.Stroke>
                            <SolidColorBrush Color="Transparent" />
                        </Path.Stroke>

                        <Path.Effect>
                            <DropShadowEffect BlurRadius="15" Direction="0" RenderingBias="Quality" ShadowDepth="0" />

                        </Path.Effect>
                        <Path.LayoutTransform>
                            <ScaleTransform ScaleY="-1" />
                        </Path.LayoutTransform>
                    </Path>

                </Canvas>





            </Grid>


        </rc:ZoomBorder>



























        <GridSplitter Grid.Column="1"
                      Width="10"
                      Margin="0 0 -10 0" Panel.ZIndex="1"
                      Background="Transparent" IsTabStop="False" ResizeDirection="Columns" />

        <ui:Card Grid.Column="2"
                 Margin="0" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
                 Background="Transparent" BorderThickness="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ui:Card Grid.Row="0"
                         Margin="5 5 0 0" Padding="20 10" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <StackPanel Grid.Row="0" Orientation="Vertical">
                        <Grid Margin="0 0" FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <Label Padding="1 2 0 0" VerticalAlignment="Center" Content="Printer" />
                            <Grid Grid.Column="2" Margin="10 0 0 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          Background="Transparent" DisplayMemberPath="Name"
                                          ItemsSource="{Binding MainVM.Printers}"
                                          SelectedItem="{Binding MainVM.Printer}" />
                                <ui:Button Grid.Column="1"
                                           Width="25" Height="35"
                                           Margin="-55 0 -10 0" Padding="0"
                                           Background="Transparent" BorderBrush="Transparent"
                                           Command="{Binding MainVM.ConfigurePrinterCommand}"
                                           CommandParameter="Ender 3 S1">
                                    <ui:SymbolIcon Margin="0" Symbol="Settings24" />
                                </ui:Button>


                            </Grid>

                        </Grid>

                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Row="1"
                         Margin="5 5 0 5" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
