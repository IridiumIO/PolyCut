<Page x:Class="ExportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:loc="clr-namespace:LazyTranslate;assembly=LazyTranslate"
      xmlns:local="clr-namespace:PolyCut"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="ExportPage"
      Margin="0 5 0 0"
      d:DataContext="{d:DesignInstance Type=local:ExportViewModel}"
      d:DesignHeight="700"
      d:DesignWidth="800"
      Background="{StaticResource ControlFillColorTertiaryBrush}"
      mc:Ignorable="d">

    <Grid Width="800" MinWidth="200" MaxWidth="700"
          Margin="42" HorizontalAlignment="Center"
          ColumnDefinitions="* *" RowDefinitions="auto auto auto auto auto auto"
          TextBlock.Foreground="{StaticResource TextControlForeground}"
          TextOptions.TextFormattingMode="Display">

        <TextBlock loc:L.Value="Export" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1"
                   Margin="0 5 0 0"
                   loc:L.Value="Save GCode file or send it directly to your machine"
                   Foreground="{StaticResource TextControlForegroundDisabled}" />

        <StackPanel Grid.RowSpan="2" Grid.Column="1"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Orientation="Horizontal" TextBlock.FontSize="16">
            <ui:SymbolIcon VerticalAlignment="Center" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Symbol="Print16" />
            <TextBlock Margin="8 -3 0 0" VerticalAlignment="Center" Text="{Binding MainVM.Printer.Name}" />
            <ui:Button Margin="15 0 0 0"
                       Background="Transparent" BorderThickness="0"
                       Command="{Binding MainVM.ConfigurePrinterCommand}">
                <ui:SymbolIcon FontSize="16" Symbol="Settings16" />
            </ui:Button>
        </StackPanel>

        <Border Grid.Row="2" Grid.ColumnSpan="2"
                Margin="0 20" Padding="20"
                Background="{StaticResource CardBackgroundDisabled}"
                CornerRadius="12">

            <StackPanel>
                <StackPanel Orientation="Horizontal" TextBlock.FontSize="16">
                    <ui:SymbolIcon VerticalAlignment="Center" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Symbol="Document16" />
                    <TextBlock Margin="10 -2 0 0" VerticalAlignment="Center" Text="Output File" />
                </StackPanel>
                <TextBlock Margin="0 10 0 5" VerticalAlignment="Center"
                           Foreground="{StaticResource TextControlForegroundDisabled}"
                           Text="File Name" />
                <ui:TextBox x:Name="OutputFileName"
                            Grid.Column="1"
                            Height="37"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Text="{Binding FilePath, Mode=TwoWay}" />

                <Button Width="220" Height="37"
                        Margin="0 10 0 0"
                        Command="{Binding SaveFileCommand}">

                    <StackPanel Orientation="Horizontal">

                        <ui:SymbolIcon FontSize="16" Symbol="Save16" />
                        <TextBlock Margin="10 0 0 0"
                                   loc:L.Value="Save to file" FontWeight="SemiBold" SnapsToDevicePixels="True" />

                    </StackPanel>

                </Button>

            </StackPanel>




        </Border>


        <TextBlock Grid.Row="3"
                   Margin="0 20 0 0"
                   FontSize="16" FontWeight="SemiBold" Text="Send to machine" />

        <Border Grid.Row="4"
                Margin="0 15 10 15" Padding="20"
                Background="{StaticResource CardBackgroundDisabled}"
                CornerRadius="12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" TextBlock.FontSize="16">
                    <ui:SymbolIcon VerticalAlignment="Center" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Symbol="SubGrid20" />
                    <TextBlock Margin="10 -2 0 0" VerticalAlignment="Center" Text="Trace Bounds" />
                </StackPanel>
                <TextBlock Height="38"
                           Margin="0 10 0 0"
                           FontSize="14"
                           Foreground="{StaticResource TextControlForegroundDisabled}"
                           Text="Upload only the design's bounding box for the tool to trace in the air, to verify alignment" TextWrapping="Wrap" />

                <ui:Button Margin="0 20 0 0" HorizontalAlignment="Stretch"
                           Background="Transparent"
                           Command="{Binding NetworkUploadPreviewCommand}">
                    <StackPanel Orientation="Horizontal">

                        <ui:SymbolIcon Margin="0 2 0 0" FontSize="16" Symbol="Eye16" />
                        <TextBlock Margin="10 0 0 0"
                                   loc:L.Value="Send Alignment Trace" FontWeight="SemiBold" SnapsToDevicePixels="True" />

                    </StackPanel>
                </ui:Button>

            </StackPanel>




        </Border>

        <Border Grid.Row="4" Grid.Column="1"
                Margin="10 15 0 15" Padding="20"
                Background="{StaticResource CardBackgroundDisabled}"
                CornerRadius="12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" TextBlock.FontSize="16">
                    <ui:SymbolIcon VerticalAlignment="Center" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Symbol="Send16" />
                    <TextBlock Margin="10 -2 0 0" VerticalAlignment="Center" Text="Send Job" />
                </StackPanel>
                <TextBlock Height="38"
                           Margin="0 10 0 0"
                           FontSize="14"
                           Foreground="{StaticResource TextControlForegroundDisabled}"
                           Text="Upload the generated GCode to the configured machine" TextWrapping="Wrap" />

                <ui:Button Margin="0 20 0 0" HorizontalAlignment="Stretch"
                           Background="Transparent"
                           Command="{Binding NetworkUploadPreviewCommand}">
                    <StackPanel Orientation="Horizontal">

                        <ui:SymbolIcon Margin="0 2 0 0" FontSize="16" Symbol="Send16" />
                        <TextBlock Margin="10 0 0 0"
                                   loc:L.Value="Send GCode" FontWeight="SemiBold" SnapsToDevicePixels="True" />

                    </StackPanel>
                </ui:Button>



            </StackPanel>




        </Border>

        <CheckBox Grid.Row="6"
                  Margin="0 0 0 0"
                  loc:L.Value="Automatically start printing after upload"
                  IsChecked="{Binding MainVM.Printer.ExportConfig.AutoPrint, Mode=TwoWay}" />



    </Grid>
</Page>
