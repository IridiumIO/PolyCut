<UserControl x:Class="Tab_Configure"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:LazyTranslate;assembly=LazyTranslate"
             xmlns:local="clr-namespace:PolyCut"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pc="clr-namespace:PolyCut.Core;assembly=PolyCut.Core"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="FillTypes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="pc:FillType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <DataTemplate x:Key="ZHeightTooltip">
            <TextBlock loc:L.Context="Z Height Tooltip" TextAlignment="Left" TextWrapping="Wrap">
                <Run loc:L.Value="How high above the workpiece the toolhead should be positioned when travelling or drawing." />
                <LineBreak /><LineBreak />
                <Run loc:L.Value="Positive values are offset above the bed surface." />
                <LineBreak /><LineBreak />
                <Run loc:L.Value="This value is affected by your printer's Z-Offset." />
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="PassHeightDeltaTooltip">
            <TextBlock loc:L.Context="Z Offset Per Pass Tooltip" TextAlignment="Left" TextWrapping="Wrap">
                <Run loc:L.Value="The distance in Z that the tool should move after each pass when multiple passes are enabled." />
                <LineBreak /><LineBreak />
                <Run loc:L.Value="Positive values move the tool up after each pass, while negative values move the tool down after each pass." />
                <LineBreak /><LineBreak />
                <Run loc:L.Value="For cutting or engraving thicker materials, a slightly negative value can be used to gradually cut deeper with each pass, which can improve quality and reduce the chance of blade breakage." />
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="ToolDiameterTooltip">
            <TextBlock loc:L.Context="Tool Diameter Tooltip" TextAlignment="Left" TextWrapping="Wrap">
                <Run loc:L.Value="of the swivelling part of the cutting blade." />
                <LineBreak />
                <Run loc:L.Value="Most blades are ~1mm in diameter, however the point of the blade may not be at the very edge." />
                <LineBreak />
                <LineBreak />
                <Run loc:L.Value="Setting the tool diameter correctly adds a compensatory swivel for blade rotation to align with the next move. This is most noticeable on tiny features." />
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>


    <Grid RowDefinitions="Auto *">

        <Separator Margin="5" />
        <ScrollViewer Grid.Row="1"
                      Margin="-14 10 -14 0" Padding="25 0 25 0"
                      VerticalScrollBarVisibility="Visible">

            <StackPanel>

                <!--
                    ====================
                    TOOL MODE SELECTION
                    ====================
                -->

                <Grid HorizontalAlignment="Center" DataContext="{Binding MainVM.Configuration}" Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="90" SharedSizeGroup="Tools" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="*" MinWidth="90" SharedSizeGroup="Tools" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="modeCut"
                                 Grid.Column="0"
                                 Height="55"
                                 Padding="0" HorizontalAlignment="Stretch"
                                 IsChecked="{Binding SelectedToolMode, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter={x:Static pc:ProcessorConfiguration+ToolMode.Cut}}"
                                 Style="{StaticResource {x:Type ToggleButton}}">
                        <StackPanel>
                            <Canvas Width="16" Height="16" Margin="0 6 0 0">
                                <Viewbox>
                                    <Viewbox.RenderTransform>
                                        <ScaleTransform ScaleX="2.3" ScaleY="2.3" />
                                    </Viewbox.RenderTransform>
                                    <Path Data="M 1.7782995,3.9862434 0.53238827,5.2321547 c 0,0 0.91525623,0.1421892 1.27745323,-0.015771 1.2637,-0.5511209 1.3947617,-1.2627027 1.3865444,-1.251957 z m 0,10e-8 2.9491822,-2.99649541 C 5.3229311,0.38474594 6.3231899,1.3412513 5.8156826,1.8729256 L 3.8285332,3.9547014 Z" Stroke="White" StrokeThickness="0.4" />
                                </Viewbox>

                            </Canvas>
                            <TextBlock Margin="0 4 0 0" HorizontalAlignment="Center"
                                       loc:L.Context="Tool Mode" loc:L.Value="Cut" FontWeight="SemiBold" />

                        </StackPanel>

                        <RadioButton.ToolTip>
                            <TextBlock loc:L.Context="Tool Mode Tooltip" loc:L.Value="Settings designed for cutting objects out using a drag-knife." TextWrapping="Wrap" />
                        </RadioButton.ToolTip>

                    </RadioButton>

                    <RadioButton x:Name="modeDraw"
                                 Grid.Column="2"
                                 Height="55"
                                 Padding="0" HorizontalAlignment="Stretch"
                                 IsChecked="{Binding SelectedToolMode, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter={x:Static pc:ProcessorConfiguration+ToolMode.Draw}}"
                                 Style="{StaticResource {x:Type ToggleButton}}">
                        <StackPanel>
                            <ui:SymbolIcon Margin="0 6 0 0" Symbol="Pen20" />
                            <TextBlock Margin="0 4 0 0" HorizontalAlignment="Center"
                                       loc:L.Context="Tool Mode" loc:L.Value="Draw" FontWeight="SemiBold" />

                        </StackPanel>
                        <RadioButton.ToolTip>
                            <TextBlock loc:L.Context="Tool Mode Tooltip" loc:L.Value="Settings designed for drawing using a pen, marker, or even a foil stamping pen." TextAlignment="Left" TextWrapping="Wrap" />
                        </RadioButton.ToolTip>
                    </RadioButton>

                </Grid>

                <!--
                    ====================
                    TRAVEL AND Z HEIGHT
                    ====================
                -->

                <StackPanel DataContext="{Binding MainVM.Configuration}">
                    <local:AnnotatedSlider LabelText="{loc:T 'Travel Speed'}"
                                           Maximum="100" Minimum="10"
                                           ToolTipMain="{loc:T 'Speed of the toolhead when the tool is raised and not actively cutting/drawing.',
                                                               Context='Travel Speed ToolTip'}"
                                           UnitText="mm/s"
                                           Value="{Binding TravelSpeed}" />
                    <local:AnnotatedSlider LabelText="{loc:T 'Work Speed'}"
                                           Maximum="60" Minimum="5"
                                           ToolTipMain="{loc:T 'Speed of the toolhead when the tool is down and cutting/drawing.',
                                                               Context='Tool Speed Tooltip'}"
                                           ToolTipSub="{loc:T 'Slower is usually better',
                                                              Context='Tool Speed Tooltip'}"
                                           UnitText="mm/s"
                                           Value="{Binding WorkSpeed}" />
                    <Label Margin="0 10 0 0" loc:L.Value="Z Height" />
                    <Grid ColumnDefinitions="* 20 *">

                        <local:AnnotatedNumberBox Grid.Column="0"
                                                  AllowNegative="True" EditorWidth="95"
                                                  LabelText="{loc:T 'Work'}"
                                                  ToolTipTemplate="{StaticResource ZHeightTooltip}"
                                                  UnitText="mm"
                                                  Value="{Binding WorkZ}" />
                        <local:AnnotatedNumberBox Grid.Column="2"
                                                  AllowNegative="True" EditorWidth="95"
                                                  LabelText="{loc:T 'Travel'}"
                                                  ToolTipTemplate="{StaticResource ZHeightTooltip}"
                                                  UnitText="mm"
                                                  Value="{Binding TravelZ}" />
                    </Grid>
                </StackPanel>

                <Separator Margin="0 10 0 0" />

                <!--
                    ====================
                    PROCESSING SETTINGS
                    ====================
                -->
                <local:AnnotatedSection DataContext="{Binding MainVM.Configuration}" LabelText="{loc:T 'Processing Settings'}">
                    <local:AnnotatedNumberBox AllowZero="False"
                                              LabelText="{loc:T 'Curve-fitting Precision'}"
                                              ToolTipMain="{loc:T 'Curved lines are approximated as straight lines when converted to GCode. This sets the effective smallest length that each segment of the curve should be. Smaller values increase accuracy, but massively increase processing time.',
                                                                  Context='Curve-fitting Precision Tooltip'}"
                                              UnitText="mm"
                                              Value="{Binding Tolerance}" />
                    <local:AnnotatedNumberBox AllowZero="False"
                                              LabelText="{loc:T 'Number of Passes'}"
                                              ToolTipMain="{loc:T 'How many times the tool should pass over the same area. Multiple passes can be used to cut/draw deeper or darker, or to improve quality by going over the same path multiple times.',
                                                                  Context='Number of Passes Tooltip'}"
                                              Value="{Binding Passes}" />
                    <local:AnnotatedNumberBox AllowNegative="True"
                                              LabelText="{loc:T 'Z Offset Per Pass'}"
                                              ToolTipTemplate="{StaticResource PassHeightDeltaTooltip}"
                                              UnitText="mm"
                                              Value="{Binding PassHeightDelta}" />
                    <local:AnnotatedToggleSwitch IsChecked="{Binding SimplifyToolPaths}" LabelText="{loc:T 'Simplify Toolpaths'}" ToolTipMain="{loc:T 'Cleans up toolpaths by merging extremely close vertices, fragments, and almost-collinear segments.'}">
                        <local:AnnotatedNumberBox AllowNegative="True"
                                                  LabelText="{loc:T 'Merge Angle'}"
                                                  ToolTipMain="{loc:T 'Angle (in degrees) between two lines, below which we merge them into a single straight line. Increasing this value (~1-5) can help when using a cutter, as it reduces the frequency of corrective swivels being made that could cause tearing.',
                                                                      Context='Merge Angle Tooltip'}"
                                                  UnitText="&#176;"
                                                  Value="{Binding SimplifyMergeAngle}" />
                    </local:AnnotatedToggleSwitch>
                    <local:AnnotatedToggleSwitch IsChecked="{Binding ExtractOneColour}" LabelText="{loc:T 'Extract One Colour'}" ToolTipMain="{loc:T 'Processes only objects with the specified colour, and ignores all others.', Context='Extract One Colour Tooltip'}">
                        <local:AnnotatedColourPicker LabelText="{loc:T 'Colour'}" ToolTipMain="{loc:T 'Processes only objects with the specified colour, and ignores all others.', Context='Extract One Colour Tooltip'}" Value="{Binding ExtractionColor}" />
                    </local:AnnotatedToggleSwitch>
                </local:AnnotatedSection>
                <Separator />

                <!--
                    ====================
                    CUTTING SETTINGS
                    ====================
                -->

                <local:AnnotatedSection DataContext="{Binding MainVM.Configuration.CuttingConfig}" LabelText="{loc:T 'Blade Settings'}" Visibility="{Binding IsChecked, ElementName=modeCut, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <local:AnnotatedNumberBox AllowZero="False"
                                              LabelText="{loc:T 'Tool Diameter'}"
                                              ToolTipTemplate="{StaticResource ToolDiameterTooltip}"
                                              UnitText="mm"
                                              Value="{Binding ToolDiameter}" />

                    <local:AnnotatedNumberBox AllowZero="False"
                                              LabelText="{loc:T 'Overcut'}"
                                              ToolTipMain="{loc:T 'Extends cuts by the specified amount to compensate for cutting moves ending slightly too early.',
                                                                  Context='Overcut Tooltip'}"
                                              ToolTipSub="{loc:T 'Recommended value ~1mm',
                                                                 Context='Overcut Tooltip'}"
                                              UnitText="mm"
                                              Value="{Binding Overcut}" />
                </local:AnnotatedSection>

                <!--
                    ====================
                    DRAWING SETTINGS
                    ====================
                -->

                <local:AnnotatedSection DataContext="{Binding MainVM.Configuration}" LabelText="{loc:T 'Drawing Settings'}" Visibility="{Binding IsChecked, ElementName=modeDraw, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <local:AnnotatedToggleSwitch IsChecked="{Binding OptimisedToolPath}"
                                                 LabelText="{loc:T 'Optimise Drawing Paths'}"
                                                 ToolTipMain="{loc:T 'Optimises the order in which lines are drawn to minimise travel time.',
                                                                     Context='Optimise Drawing Paths Tooltip'}"
                                                 ToolTipSub="{loc:T 'Particularly useful for ordering lines when filling shapes.',
                                                                    Context='Optimise Drawing Paths Tooltip'}" />

                    <StackPanel DataContext="{Binding DrawingConfig}">

                        <local:AnnotatedToggleSwitch IsChecked="{Binding AllowDrawingOverOutlines}"
                                                     IsEnabled="{Binding DataContext.MainVM.Configuration.OptimisedToolPath, RelativeSource={RelativeSource AncestorType=local:Tab_Configure}}"
                                                     LabelText="{loc:T 'Allow Travel in Outlines'}"
                                                     ToolTipMain="{loc:T 'Allows the pen to travel through shape outlines without lifting the pen up to start the next line.',
                                                                         Context='Allow Travel in Outlines Tooltip'}"
                                                     ToolTipRequirements="{loc:T 'Optimise Drawing Paths'}"
                                                     ToolTipSub="{loc:T 'Requires &quot;Optimise Drawing Paths&quot; to be enabled. Can massively improve overall speed',
                                                                        Context='Allow Travel in Outlines Tooltip'}" />

                        <local:AnnotatedToggleSwitch IsChecked="{Binding KeepOutlines}"
                                                     LabelText="{loc:T 'Keep Outlines'}"
                                                     ToolTipMain="{loc:T 'Whether shape outlines should be drawn, or ignored.',
                                                                         Context='Keep Outlines Tooltip'}"
                                                     ToolTipSub="{loc:T 'Disable this if you want to shade in an area without the area being outlined.',
                                                                        Context='Keep Outlines Tooltip'}" />

                        <local:AnnotatedToggleSwitch IsChecked="{Binding PenWidthCompensation}" LabelText="{loc:T 'Enable Pen Width Compensation'}" ToolTipMain="{loc:T 'Accounts for pen width to keep enclosed shapes dimensionally accurate. Narrow features may disappear; open and unfilled paths are unchanged.'}">

                            <local:AnnotatedNumberBox LabelText="{loc:T 'Pen Width'}"
                                                      ToolTipMain="{loc:T 'Accounts for pen width to keep enclosed shapes dimensionally accurate. Narrow features may disappear; open and unfilled paths are unchanged.'}"
                                                      UnitText="mm"
                                                      Value="{Binding PenWidth}" />

                            <local:AnnotatedNumberBox AllowNegative="True"
                                                      IsEnabled="{Binding KeepOutlines}"
                                                      LabelText="{loc:T 'Fill / Outline Overlap'}"
                                                      ToolTipMain="{loc:T 'Controls how much the fill overlaps retained outlines. 0% touches their inner edge; 100% reaches their outer edge. Requires pen-width compensation and Keep Outlines.'}"
                                                      ToolTipRequirements="{loc:T 'Keep Outlines'}"
                                                      UnitText="%"
                                                      Value="{Binding FillOutlineOverlap}" />
                        </local:AnnotatedToggleSwitch>
                    </StackPanel>
                </local:AnnotatedSection>


                <Separator Visibility="{Binding IsChecked, ElementName=modeDraw, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!--
                    ====================
                    FILL SETTINGS
                    ====================
                -->

                <local:AnnotatedSection DataContext="{Binding MainVM.Configuration.DrawingConfig}" LabelText="{loc:T 'Fill Settings'}" Visibility="{Binding IsChecked, ElementName=modeDraw, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <local:AnnotatedComboBox ItemsSource="{Binding Source={StaticResource FillTypes}}"
                                             LabelText="{loc:T 'Fill Style'}"
                                             SelectedItem="{Binding FillType}"
                                             ToolTipMain="{loc:T 'The method used to fill shapes',
                                                                 Context='Fill Style Tooltip'}" />
                    <StackPanel>

                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FillType}" Value="{x:Static pc:FillType.None}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <local:AnnotatedNumberBox x:Name="ShadingThresholdControl"
                                                  AllowNegative="True"
                                                  LabelText="{loc:T 'Shading Threshold'}"
                                                  MouseEnter="ShadingThreshold_MouseEnter" MouseLeave="ShadingThreshold_MouseLeave" TextChanged="ShadingThreshold_TextChanged"
                                                  ToolTipMain="{loc:T 'Range = 0 to 1',
                                                                      Context='Shading Threshold Tooltip'}"
                                                  ToolTipSub="{loc:T 'How bright an object should be in order to be shaded. 0 = shade all objects, 1 = shade only fully bright objects.',
                                                                     Context='Shading Threshold Tooltip'}"
                                                  Unloaded="ShadingThreshold_Unloaded"
                                                  Value="{Binding ShadingThreshold}" />

                        <local:AnnotatedNumberBox AllowZero="False"
                                                  LabelText="{loc:T 'Lightest shading spacing'}"
                                                  ToolTipMain="{loc:T 'How far apart drawn lines should be when shading the lightest parts of the image.',
                                                                      Context='Lightest Shading Spacing Tooltip'}"
                                                  UnitText="mm"
                                                  Value="{Binding MaxStrokeWidth}" />

                        <local:AnnotatedNumberBox AllowZero="False"
                                                  LabelText="{loc:T 'Darkest shading spacing'}"
                                                  ToolTipMain="{loc:T 'How far apart drawn lines should be when shading the darkest parts of the image.',
                                                                      Context='Darkest Shading Spacing Tooltip'}"
                                                  UnitText="mm"
                                                  Value="{Binding MinStrokeWidth}" />

                        <local:AnnotatedNumberBox AllowNegative="True"
                                                  LabelText="{loc:T 'Shading angle'}"
                                                  ToolTipMain="{loc:T 'Which Direction to draw when shading objects.',
                                                                      Context='Shading Angle Tooltip'}"
                                                  ToolTipSub="{loc:T '0° represents East, with positive values rotating counterclockwise.',
                                                                     Context='Shading Angle Tooltip'}"
                                                  UnitText="&#176;"
                                                  Value="{Binding ShadingAngle}" />

                        <local:AnnotatedToggleSwitch IsChecked="{Binding OutlinesBeforeFill}"
                                                     LabelText="{loc:T 'Draw Outlines Before Fill'}"
                                                     ToolTipMain="{loc:T 'Draws the outlines of shapes before filling them in.',
                                                                         Context='Outlines Before Fill Tooltip'}"
                                                     ToolTipSub="{loc:T 'Usually you want to draw outlines after filling.',
                                                                        Context='Outlines Before Fill Tooltip'}" />
                    </StackPanel>
                </local:AnnotatedSection>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
