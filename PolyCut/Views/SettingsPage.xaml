<Page x:Class="SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:Flags="clr-namespace:FamFamFam.Flags.Wpf;assembly=FamFamFam.Flags.Wpf"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:loc="clr-namespace:PolyCut.Localisation;assembly=PolyCut.Localisation"
      xmlns:local="clr-namespace:PolyCut"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pc="clr-namespace:PolyCut.Core;assembly=PolyCut.Core"
      xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vc="clr-namespace:ValueConverters;assembly=ValueConverters"
      Title="SettingsPage"
      Margin="42 42 42 40"
      d:DataContext="{d:DesignInstance Type=local:SettingsPageViewModel}"
      d:DesignHeight="700"
      d:DesignWidth="800"
      mc:Ignorable="d">
    <Page.Resources>

        <Flags:CountryIdToFlagImageSourceConverter x:Key="CountryIdToFlagImageSourceConverter" />

    </Page.Resources>
    <Grid>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <svgc:SvgViewbox Height="50"
                                 Margin="5" HorizontalAlignment="Left" Panel.ZIndex="-2"
                                 Source="pack://application:,,,/PolyCut;component/Resources/banner_dark.svg" />
                <TextBlock Margin="14" VerticalAlignment="Bottom"
                           FontSize="20" Foreground="#80FFFFFF">
                    <Run loc:L.Value="version" />
                    <Run Text="{x:Static local:SettingsHandler.Version}" />
                </TextBlock>
            </StackPanel>


            <Separator Margin="0 10" />
            <Label loc:L.Value="Global Settings" FontWeight="SemiBold" />

            <StackPanel Width="400"
                        Margin="10 0 0 0" HorizontalAlignment="Left"
                        Orientation="Horizontal">
                <Label Width="160" VerticalAlignment="Center" loc:L.Value="UI Language" />
                <ComboBox x:Name="UiLanguageComboBox"
                          Margin="0 10 0 10"
                          ItemsSource="{Binding LanguageItems}"
                          SelectedIndex="0" SelectionChanged="UiLanguageComboBox_SelectionChanged">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">

                                <Image Width="20" Source="{Binding ISOCountryCode, Converter={StaticResource CountryIdToFlagImageSourceConverter}}" />

                                <TextBlock x:Name="LanguageText"
                                           Grid.Column="1"
                                           Margin="6 0 0 0" VerticalAlignment="Center"
                                           Text="{Binding LanguageName}" />
                            </StackPanel>



                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>
                <ui:Button Margin="10 0 0 0"
                           Background="Transparent" BorderThickness="0"
                           Command="{Binding CheckForLanguageUpdatesCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowCircleDown20" />
                    </StackPanel>
                    <ui:Button.ToolTip>
                        <ToolTip loc:L.Value="Reload Languages. Checks online for updated language definitions" />
                    </ui:Button.ToolTip>
                </ui:Button>
            </StackPanel>

            <StackPanel Margin="10" Orientation="Horizontal">
                <Label Width="160" loc:L.Value="Start Menu Shortcut" />

                <ui:ToggleSwitch x:Name="AddToStartMenuCheckBox"
                                 Checked="AddToStartMenuCheckBox_Checked"
                                 IsChecked="{Binding MainVM.UIConfiguration.AddToStartMenu, Mode=OneWay}"
                                 Unchecked="AddToStartMenuCheckBox_Unchecked" />
            </StackPanel>


            <Separator Margin="0 10" />

            <Label loc:L.Value="Grid Settings" FontWeight="SemiBold" />
            <Grid HorizontalAlignment="Stretch" loc:L.Context="Grid Settings">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="400" MaxWidth="600" />
                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>
                <StackPanel>
                    <local:LabeledNumberBoxControl Margin="10 0 0 0"
                                                   LabelText="{loc:T Spacing}"
                                                   Text="{Binding MainVM.UIConfiguration.GridConfig.Spacing, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource UnitConverter}}"
                                                   TextBoxWidth="100" UnitText="mm" />
                    <Grid Margin="10 0 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <local:LabeledNumberBoxControl Margin="0 0 15 0"
                                                       LabelText="{loc:T 'Inset (Left)'}"
                                                       Text="{Binding MainVM.UIConfiguration.GridConfig.InsetLeft, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource UnitConverter}, ConverterParameter='allownegative'}"
                                                       TextBoxWidth="100" UnitText="mm" />
                        <local:LabeledNumberBoxControl Grid.Column="1"
                                                       LabelText="{loc:T 'Inset (Right)'}"
                                                       Text="{Binding MainVM.UIConfiguration.GridConfig.InsetRight, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource UnitConverter}, ConverterParameter='allownegative'}"
                                                       TextBoxWidth="100" UnitText="mm" />
                    </Grid>
                    <Grid Margin="10 0 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <local:LabeledNumberBoxControl Margin="0 0 15 0"
                                                       LabelText="{loc:T 'Inset (Top)'}"
                                                       Text="{Binding MainVM.UIConfiguration.GridConfig.InsetTop, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource UnitConverter}, ConverterParameter='allownegative'}"
                                                       TextBoxWidth="100" UnitText="mm" />
                        <local:LabeledNumberBoxControl Grid.Column="1"
                                                       LabelText="{loc:T 'Inset (Bottom)'}"
                                                       Text="{Binding MainVM.UIConfiguration.GridConfig.InsetBottom, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource UnitConverter}, ConverterParameter='allownegative'}"
                                                       TextBoxWidth="100" UnitText="mm" />
                    </Grid>

                    <local:ColorPickerControl Margin="10 5 0 5"
                                              ColorSelected="ColorPickerControl_ColorSelected"
                                              CurrentColor="{Binding MainVM.UIConfiguration.GridConfig.GridBrush, Mode=TwoWay, Converter={local:BrushToHexStringConverter}}"
                                              Foreground="{DynamicResource CardForeground}"
                                              LabelText="{loc:T 'Gridline Colour'}" />
                    <Separator Margin="0 10" />
                    <Label Margin="0 0 0 10" loc:L.Value="Canvas Color" FontWeight="SemiBold" />
                    <ComboBox x:Name="CanvasColourSelection"
                              MinWidth="300"
                              HorizontalAlignment="Left"
                              SelectionChanged="ComboBox_SelectionChanged">
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                        <ComboBoxItem Content="Translucent" />
                    </ComboBox>

                </StackPanel>


                <Viewbox Grid.Column="1"
                         MinWidth="100" MaxWidth="600" MaxHeight="280"
                         Margin="20 0 0 0" HorizontalAlignment="Left" VerticalAlignment="Top"
                         SnapsToDevicePixels="True" Stretch="Uniform" StretchDirection="Both" UseLayoutRounding="True">
                    <Grid>
                        <Border Margin="-1" Panel.ZIndex="1"
                                Background="{Binding MainVM.UIConfiguration.CanvasThemeColour}"
                                BorderBrush="DimGray" BorderThickness="1" CornerRadius="5" />
                        <Border Width="{Binding MainVM.Printer.BedWidth}"
                                Height="{Binding MainVM.Printer.BedHeight}"
                                Margin="-1" Panel.ZIndex="1">
                            <Border.Clip>
                                <RectangleGeometry Rect="{Binding GridClipRect}" />
                            </Border.Clip>
                            <Border.Background>
                                <DrawingBrush Stretch="None" TileMode="Tile"
                                              Viewport="{Binding PrinterGridPreviewViewport}"
                                              ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing>
                                            <GeometryDrawing.Geometry>
                                                <GeometryGroup>
                                                    <LineGeometry StartPoint="0,0" EndPoint="{Binding GridLineHorizontalEnd}" />
                                                    <LineGeometry StartPoint="0,0" EndPoint="{Binding GridLineVerticalEnd}" />
                                                </GeometryGroup>
                                            </GeometryDrawing.Geometry>
                                            <GeometryDrawing.Pen>
                                                <Pen Brush="{Binding MainVM.UIConfiguration.GridConfig.GridBrush}" Thickness="0.3" />
                                            </GeometryDrawing.Pen>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Viewbox>


            </Grid>

            <Separator Margin="0 10" />
            <Label loc:L.Value="Preview Page Settings" FontWeight="SemiBold" />
            <StackPanel Width="390" MaxWidth="390"
                        Margin="10 0 0 0" HorizontalAlignment="Left">
                <local:ColorPickerControl x:Name="PreviewPage_DrawingBrushColorSelector"
                                          Margin="0 5"
                                          ColorSelected="PreviewPage_DrawingBrushColorSelector_ColorSelected"
                                          CurrentColor="{Binding MainVM.UIConfiguration.PreviewDrawingBrush, Mode=TwoWay, Converter={local:BrushToHexStringConverter}}"
                                          Foreground="{DynamicResource CardForeground}"
                                          LabelText="{loc:T 'Drawing Line Colour'}" />
                <local:ColorPickerControl x:Name="PreviewPage_TravelBrushColorSelector"
                                          Margin="0 5"
                                          ColorSelected="PreviewPage_TravelBrushColorSelector_ColorSelected"
                                          CurrentColor="{Binding MainVM.UIConfiguration.PreviewTravelBrush, Mode=TwoWay, Converter={local:BrushToHexStringConverter}}"
                                          Foreground="{DynamicResource CardForeground}"
                                          LabelText="{loc:T 'Travel Line Colour'}" />

                <local:ColorPickerControl x:Name="PreviewPage_CursorBrushColorSelector"
                                          Margin="0 5"
                                          ColorSelected="PreviewPage_CursorBrushColorSelector_ColorSelected"
                                          CurrentColor="{Binding MainVM.UIConfiguration.PreviewCursorBrush, Mode=TwoWay, Converter={local:BrushToHexStringConverter}}"
                                          Foreground="{DynamicResource CardForeground}"
                                          LabelText="{loc:T 'Cursor Colour'}" />

            </StackPanel>

        </StackPanel>

    </Grid>
</Page>
