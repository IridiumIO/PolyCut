<UserControl x:Class="ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LazyTranslate;assembly=LazyTranslate"
             xmlns:local="clr-namespace:PolyCut"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Label VerticalAlignment="Center" Content="{Binding LabelText, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Label.Style>
                <Style BasedOn="{StaticResource {x:Type Label}}" TargetType="Label">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Label.Style>
        </Label>
        <Button x:Name="ColorButton" Grid.Column="1" Click="ColorButton_Click">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Padding" Value="4" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">

                            <Setter Property="Padding" Value="0" />

                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Border Background="{Binding CurrentColor, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="48" />
                        <Setter Property="Height" Value="24" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Width" Value="20" />
                                <Setter Property="Height" Value="20" />

                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </Button>
        <Popup x:Name="ColorPopup"
               AllowsTransparency="True" Placement="Bottom"
               PlacementTarget="{Binding ElementName=ColorButton}"
               StaysOpen="False">
            <Border Padding="5">
                <Border x:Name="ColorPopupBorder"
                        Padding="8"
                        local:MicaBackdrop.IsEnabled="True" local:MicaBackdrop.TintColor="#23FFFFFF"
                        Background="{Binding RelativeSource={RelativeSource Self}, Path=(local:MicaBackdrop.SurfaceBrush), TargetNullValue={StaticResource ApplicationBackgroundBrush}, FallbackValue={StaticResource ApplicationBackgroundBrush}}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Direction="270" Opacity="0.8" ShadowDepth="2" />
                    </Border.Effect>
                    <StackPanel>
                        <ItemsControl x:Name="DefaultColorsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="5" Padding="5"
                                            Background="Transparent" BorderThickness="0" Click="ColorMenuItem_Click"
                                            Tag="{Binding}">
                                        <Border Width="32" Height="32"
                                                Background="{Binding}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="4" />
                                        <Button.ToolTip>
                                            <ToolTip Content="{Binding}" />
                                        </Button.ToolTip>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.Items>
                                <SolidColorBrush Color="Black" />
                                <SolidColorBrush Color="Red" />
                                <SolidColorBrush Color="Cyan" />
                                <SolidColorBrush Color="Orange" />
                                <SolidColorBrush Color="Gray" />
                                <SolidColorBrush Color="Blue" />
                                <SolidColorBrush Color="Magenta" />
                                <SolidColorBrush Color="Indigo" />
                                <SolidColorBrush Color="White" />

                                <SolidColorBrush Color="#FF00FF00" />


                                <SolidColorBrush Color="Yellow" />
                                <SolidColorBrush Color="Transparent" />

                            </ItemsControl.Items>
                        </ItemsControl>

                        <Separator x:Name="WorkspaceColorsSeparator" Margin="0 8 0 0" Visibility="Collapsed" />

                        <ScrollViewer x:Name="WorkspaceColorsScroller"
                                      Width="{Binding ActualWidth, ElementName=DefaultColorsList}"
                                      Margin="0 8 0 0"
                                      HorizontalScrollBarVisibility="Auto" PreviewMouseWheel="WorkspaceColorsScroller_PreviewMouseWheel" VerticalScrollBarVisibility="Disabled" Visibility="Collapsed">
                            <ItemsControl x:Name="WorkspaceColorsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Margin="0 0 0 10" Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="3" Padding="3"
                                                Background="Transparent" BorderThickness="0" Click="ColorMenuItem_Click"
                                                Tag="{Binding}">
                                            <Border Width="16" Height="16"
                                                    Background="{Binding}"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="4" />
                                            <Button.ToolTip>
                                                <ToolTip Content="{Binding}" />
                                            </Button.ToolTip>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Separator Margin="0 0 0 8" />

                        <Grid Margin="8 0 8 8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0 0 8 0" VerticalAlignment="Center" Text="Hex:" />
                            <ui:TextBox x:Name="HexTextBox"
                                        Grid.Column="1"
                                        KeyDown="HexTextBox_KeyDown" LostFocus="HexTextBox_LostFocus" MaxLength="9"
                                        Text="{Binding HexColor, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                                <ui:TextBox.ToolTip>
                                    <ToolTip loc:L.Value="Enter hex color (e.g., #FFFF0000 or #FF0000)" />
                                </ui:TextBox.ToolTip>
                            </ui:TextBox>

                            <ui:Button x:Name="EyedropperButton"
                                       Grid.Column="2"
                                       Width="35" Height="35"
                                       Margin="8 0 0 0" Padding="4"
                                       Click="EyedropperButton_Click">
                                <ui:SymbolIcon Symbol="Eyedropper20" />
                            </ui:Button>
                        </Grid>


                    </StackPanel>
                </Border>
            </Border>

        </Popup>
    </Grid>
</UserControl>
